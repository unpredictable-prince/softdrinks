# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Fizzora Beverages Management System"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://localhost:5432/fizzora_db"

# Security & Authentication
SECRET_KEY="insecure-dev-secret-key-change-in-production-fizzora-2026-secure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Default Super Admin (Used during seeding/bootstrap)
ADMIN_DEFAULT_NAME="Owner Admin"
ADMIN_DEFAULT_EMAIL="admin@fizzora.in"
ADMIN_DEFAULT_PASSWORD="FizzoraAdmin2026!"

# Business Metadata (Configurable)
BRAND_NAME="Fizzora"
BUSINESS_CITY="Ahmedabad"
BUSINESS_STATE="Gujarat"
BUSINESS_COUNTRY="India"
BUSINESS_PHONE="+91 98765 43210"
BUSINESS_WHATSAPP="+919876543210"
BUSINESS_EMAIL="contact@fizzora.in"
BUSINESS_INSTAGRAM="https://instagram.com/fizzora_drinks"
